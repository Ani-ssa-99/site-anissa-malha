---
layout: base.njk
title: Espace client
permalink: /espace-client/
extra_css: ["/assets/espace/espace.css", "/assets/espace/marque.css"]
extra_js: ["https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3/dist/umd/supabase.js", "/assets/espace/espace-config.js", "/assets/espace/espace.js"]
---
<section class="band ec"><div class="in">
  <div class="ec-app" data-ec>
    <p class="ec-loading">Chargement…</p>
  </div>
</div></section>
<!-- Formulaires cachés : Netlify t'envoie un e-mail à chaque inscription et à chaque message client. -->
<form name="inscription-pro" data-netlify="true" netlify-honeypot="societe-web" hidden>
  <input name="societe"><input name="siret"><input name="email"><input name="nom"><input name="telephone"><input name="siret-verifie"><input name="societe-web">
</form>
<form name="message-client" data-netlify="true" netlify-honeypot="societe-web" hidden>
  <input name="societe"><input name="email"><textarea name="message"></textarea><input name="societe-web">
</form>
